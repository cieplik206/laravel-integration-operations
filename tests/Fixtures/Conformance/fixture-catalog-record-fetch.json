{
    "$schema": "../../../contracts/provider-spi-0.1.schema.json",
    "contract": "cieplik206.integration-operations.provider-spi",
    "spi_version": "0.1",
    "provider": "fixture_catalog",
    "operations": [
        {
            "operation_type": "fixture_catalog.record.fetch",
            "versions": {
                "payload_schema": 1,
                "handler": 1,
                "result_schema": 1
            },
            "effect": {
                "max_remote_writes": 0,
                "boundary": "forbidden"
            },
            "extension_points": [
                "operation_handler",
                "failure_classifier",
                "retry_policy",
                "result_codec",
                "outcome_projector"
            ],
            "retry": {
                "mode": "read_safe",
                "safe_retry_evidence": [
                    "request_not_started",
                    "definitive_transient_read"
                ],
                "ambiguous_effect_action": "not_applicable"
            },
            "reconciliation": {
                "mode": "none",
                "results": []
            },
            "terminal_contracts": {
                "succeeded": {
                    "status": "succeeded",
                    "disposition": "succeeded",
                    "terminal": true,
                    "effect_states": [
                        "not_started"
                    ],
                    "result_availability": [
                        "available"
                    ]
                },
                "failed": {
                    "status": "failed",
                    "disposition": "failed",
                    "terminal": true,
                    "effect_states": [
                        "not_started"
                    ],
                    "result_availability": [
                        "not_applicable"
                    ]
                },
                "cancelled": {
                    "status": "cancelled",
                    "disposition": "cancelled",
                    "terminal": true,
                    "effect_states": [
                        "not_started"
                    ],
                    "result_availability": [
                        "not_applicable"
                    ]
                }
            }
        }
    ]
}
