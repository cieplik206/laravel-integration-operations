{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cieplik206/laravel-integration-operations",
    "description": "Durable integration operation kernel for Laravel applications and provider SDKs",
    "keywords": [
        "durable-operations",
        "idempotency",
        "integration",
        "laravel",
        "outbox",
        "reconciliation",
        "workflow"
    ],
    "homepage": "https://github.com/cieplik206/laravel-integration-operations",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Paweł Ciepliński",
            "homepage": "https://github.com/cieplik206",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cieplik206/laravel-integration-operations/issues",
        "security": "https://github.com/cieplik206/laravel-integration-operations/security/policy",
        "source": "https://github.com/cieplik206/laravel-integration-operations"
    },
    "require": {
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "php": "^8.4",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/redis": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/uid": "^7.4|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "symfony/var-dumper": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Cieplik206\\IntegrationOperations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cieplik206\\IntegrationOperations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        },
        "laravel": {
            "providers": [
                "Cieplik206\\IntegrationOperations\\IntegrationOperationsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:pgsql": "pest --fail-on-skipped --fail-on-empty-test-suite tests/Feature/Postgres",
        "test:redis": "pest --fail-on-skipped --fail-on-empty-test-suite tests/Feature/Redis",
        "test:compatibility:min": [
            "@composer update --prefer-lowest --prefer-stable --no-interaction --no-progress",
            "@test"
        ],
        "test:compatibility:locked": [
            "git ls-files --error-unmatch composer.lock",
            "@php -r \"if (! is_file('composer.lock')) { fwrite(STDERR, 'A committed composer.lock is required for the locked compatibility gate.'.PHP_EOL); exit(1); }\"",
            "@composer install --no-interaction --no-progress",
            "@test"
        ],
        "test:compatibility:latest": [
            "@composer update --prefer-stable --no-interaction --no-progress",
            "@test"
        ],
        "analyse": "phpstan analyse",
        "format": "pint src tests config database",
        "format:check": "pint --test src tests config database",
        "quality:validate": "@composer validate --strict",
        "security:audit": "@composer audit",
        "check": [
            "@quality:validate",
            "@format:check",
            "@analyse",
            "@test",
            "@test:pgsql",
            "@test:redis",
            "@security:audit"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
